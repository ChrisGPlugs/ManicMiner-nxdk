# Desktop build (Linux/macOS/MSYS2) for development and testing.
#
#   make -f Makefile.host               # SDL2 desktop builds: ./manicminer, ./manicminer128,
#                                       # ./manicminer_combined
#   make -f Makefile.host difftest difftest128   # comparison tests vs the Z80 originals
#   make -f Makefile.host test          # run them (needs ManicMiner.bin / ManicMiner128.tap)

CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra
SDL_CFLAGS := $(shell pkg-config --cflags sdl2 2>/dev/null || sdl2-config --cflags)
SDL_LIBS   := $(shell pkg-config --libs sdl2 2>/dev/null || sdl2-config --libs)

GAME_SRCS = src/zx.c src/mm_game.c src/mm_font.c
GAME128_SRCS = src/zx.c src/mm_game.c src/mm_font.c src/ay.c src/st_player.c src/mm128_load.c
COMMON128 = src/zx.c src/mm_font.c src/ay.c src/st_player.c src/mm128_load.c
HDRS = src/*.h
B = build/host

all: manicminer manicminer128 manicminer_combined

manicminer: src/main.c $(GAME_SRCS) $(HDRS)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -o $@ src/main.c $(GAME_SRCS) $(SDL_LIBS)

$(B)/mm_game48.o: src/mm_game.c $(HDRS)
	@mkdir -p $(B)
	$(CC) $(CFLAGS) -c -o $@ src/mm_game.c

$(B)/mm_game128.o: src/mm_game.c $(HDRS)
	@mkdir -p $(B)
	$(CC) $(CFLAGS) -DMM128 -c -o $@ src/mm_game.c

manicminer128: src/main.c $(B)/mm_game128.o $(COMMON128) $(HDRS)
	$(CC) $(CFLAGS) -DMM_ONLY_128 $(SDL_CFLAGS) -o $@ src/main.c $(B)/mm_game128.o $(COMMON128) $(SDL_LIBS)

manicminer_combined: src/main.c $(B)/mm_game48.o $(B)/mm_game128.o $(COMMON128) $(HDRS)
	$(CC) $(CFLAGS) -DMM_COMBINED $(SDL_CFLAGS) -o $@ src/main.c $(B)/mm_game48.o $(B)/mm_game128.o $(COMMON128) $(SDL_LIBS)

difftest: tools/difftest.c $(GAME_SRCS) tools/z80ref/z80.c src/*.h
	$(CC) $(CFLAGS) -Wno-unused-parameter -o $@ tools/difftest.c $(GAME_SRCS) tools/z80ref/z80.c

difftest128: tools/difftest128.c $(GAME128_SRCS) tools/z80ref/z80.c src/*.h
	$(CC) $(CFLAGS) -DMM128 -Wno-unused-parameter -o $@ tools/difftest128.c $(GAME128_SRCS) tools/z80ref/z80.c

test: difftest difftest128
	./tools/run_difftest.sh

clean:
	rm -rf manicminer manicminer128 manicminer_combined difftest difftest128 build/host

.PHONY: all test clean
